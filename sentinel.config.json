{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "wandorius"
  },
  "gate": {
    "command": ["sentinel", "check", "--"],
    "taskIdRequired": true
  },
  "guard": {
    "directCommands": {
      "npmScripts": ["test", "test:changed", "test:full", "test:file", "test:watch", "type-check", "lint", "check", "check:back", "check:front", "fmt", "fmt:check", "build"],
      "npxTools": ["vitest", "tsc", "eslint", "prettier", "rustfmt"],
      "cargoSubcommands": ["check", "clippy", "test", "bench", "fmt"],
      "tools": ["vitest", "tsc", "eslint", "prettier", "rustfmt"]
    }
  },
  "runtime": {
    "minimumVersion": "0.5.0",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "project-default",
      "config": {
        "includePatterns": [
          "**/*.rs",
          "frontend/**/*.ts",
          "frontend/**/*.css",
          "scripts/**/*.mjs",
          "scripts/**/*.ps1"
        ],
        "excludePatterns": [
          "**/node_modules/**",
          "**/dist/**",
          "**/out/**",
          "**/target/**",
          "**/.quality-tools/**",
          "**/.quality-reports/**",
          "**/.sentinel/**",
          "tools/sentinel/**",
          "frontend/src/api/generated/**",
          "frontend/src/utils/dom.ts",
          "_archivo/**",
          "**/.freebuff/**",
          "**/data/inventarios/**"
        ],
        "directoryExceptions": [
          "migrations",
          "scripts",
          "src/handlers",
          "frontend",
          "src/models",
          "src/repositories",
          "src/services"
        ],
        "portableBoundaries": {
          "dom": [
            "/frontend/src/utils/dom.ts",
            "/frontend/src/platform/",
            "/frontend/src/adapters/",
            "/frontend/src/main.ts",
            "/frontend/src/components/ui/",
            "/frontend/src/features/desktop/",
            "/frontend/src/features/mobile/",
            "/frontend/src/features/runtime/",
            "/frontend/src/features/notifications/",
            "/frontend/src/features/seo/",
            "/frontend/src/utils/sanitize-html.ts",
            "/frontend/src/utils/upload.ts"
          ],
          "window": [
            "/frontend/src/platform/",
            "/frontend/src/adapters/",
            "/frontend/src/navigation/",
            "/frontend/src/main.ts",
            "/frontend/src/router.ts",
            "/frontend/src/utils/viewport.ts",
            "/frontend/src/features/seo/",
            "/frontend/src/features/analytics/",
            "/frontend/src/features/desktop/",
            "/frontend/src/features/mobile/",
            "/frontend/src/features/runtime/",
            "/frontend/src/features/notifications/",
            "/frontend/src/features/commerce/store-view.ts",  "/frontend/src/pages/verify-email.ts",
  "/frontend/src/pages/article.ts",
  "/frontend/src/utils/sanitize-html.ts"
 ],
          "services": [
            "/frontend/src/services/",
            "/frontend/src/api/",
            "/frontend/src/adapters/"
          ],
          "loggerModules": [
            "/frontend/src/services/logger",
            "/frontend/src/utils/logger"
          ]
        },
        "rules": {
          "barras-decorativas": {
            "severidad": "warning"
          },
          "catch-vacio": {
            "severidad": "error"
          },
          "hardcoded-secret": {
            "severidad": "error"
          },
          "innerhtml-variable": {
            "severidad": "error"
          },
          "unwrap-produccion-rs": {
            "severidad": "error"
          },
          "panic-produccion-rs": {
            "severidad": "error"
          },
          "git-add-all": {
            "severidad": "error"
          },
          "css-especificacion-diseno-local": {
            "severidad": "information"
          },
          "axum-ruta-sintaxis-rs": {
            "severidad": "error"
          },
          "unsafe-process-shell": {
            "severidad": "error"
          },
          "default-export": {
            "habilitada": false
          },
          "mixed-barrel-logic": {
            "habilitada": false
          }
        }
      }
    },
    "varsense": {
      "enabled": true,
      "profile": "project-default",
      "config": "varsense.config.json"
    }
  }
}
