{
  "name": "glory-rs",
  "private": true,
  "description": "Comandos unificados para el monorepo Rust + Vanilla TypeScript",
  "scripts": {
    "dev": "node glory-rs/scripts/dev.mjs",
    "check": "npm run check:back && npm run check:front",
    "self-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/self-check.ps1",
    "quality:setup": "node scripts/quality/setup.mjs",
    "quality:test": "node --test scripts/quality/tests/*.test.mjs",
    "quality:guard": "node scripts/quality/heavy-run-guard.mjs --status",
    "quality:doctor": "node scripts/quality/sentinel-doctor.mjs",
    "quality:lock": "node scripts/quality/lock-generator.mjs",
    "quality:cleanup": "node scripts/quality/target-maintenance.mjs --cleanup",
    "quality:cleanup:dry": "node scripts/quality/target-maintenance.mjs --dry-run",
    "quality:reports:cleanup": "node scripts/quality/report-cleanup.mjs --cleanup --yes",
    "quality:reports:cleanup:dry": "node scripts/quality/report-cleanup.mjs --dry-run",
    "task:take": "node scripts/quality/task-takeover.mjs take",
    "task:release": "node scripts/quality/task-takeover.mjs release",
    "task:status": "node scripts/quality/task-takeover.mjs status",
    "quality:reports:read": "node scripts/quality/report-reader.mjs",
    "quality:install-guard": "node scripts/quality/install-global-runtime.mjs",
    "quality:uninstall-guard": "node scripts/quality/install-global-runtime.mjs --uninstall",
    "task:check": "node scripts/quality/task-check.mjs",
    "gate:check": "node scripts/quality/gate-check.mjs",
    "check:back": "node scripts/run-with-db.mjs check && node scripts/run-with-db.mjs clippy",
    "check:front": "npm --prefix frontend run type-check",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "dev:back": "node scripts/run-with-db.mjs run",
    "dev:front": "npm --prefix frontend run dev",
    "codegen": "npm --prefix frontend run codegen",
    "codegen:local": "node scripts/codegen-local.mjs",
    "test": "node scripts/run-with-db.mjs test",
    "roadmap": "node scripts/check-roadmap.mjs",
    "roadmap:watch": "node scripts/check-roadmap.mjs --watch",
    "quality:profile": "node scripts/quality/quality-profile.mjs",
    "quality:bench": "node scripts/quality/bench-baseline.mjs"
  }
}
