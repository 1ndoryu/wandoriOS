# wandori.us — Variables de entorno
# Copiar a .env y configurar

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/wandorius

# La autenticacion usa sesiones opacas en cookie HttpOnly; no requiere secreto JWT.

# Servidor
HOST=127.0.0.1
PORT=3000

# Directorio de archivos subidos
UPLOAD_DIR=uploads

# Directorio del frontend compilado (para servir SPA en produccion)
FRONTEND_DIST=frontend/dist

# Email transaccional (Resend — para enviar descargas por correo)
# Obtener API key en: https://resend.com/api-keys
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@wandori.us

# Stripe (opcional — sin esto, el checkout funciona en modo demo)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug

# Admin credentials (para login en /login)
# ADMIN_EMAIL=admin@wandori.us
# ADMIN_PASSWORD=changeme
